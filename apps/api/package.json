{
  "name": "@skip-the-scroll/api",
  "version": "0.0.1",
  "private": true,
  "main": "api/index.ts",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "pnpm --filter @skip-the-scroll/shared build && tsc && node -e \"require('fs').cpSync('src/llm/prompts', 'dist/llm/prompts', { recursive: true })\"",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^3.6.0",
    "@skip-the-scroll/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
